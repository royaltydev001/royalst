rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /tracks/{trackId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'artist', 'album', 'genre', 'artwork', 'streamUrl', 'source', 'published', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.artist is string
        && request.resource.data.artwork is string
        && request.resource.data.streamUrl is string
        && request.resource.data.source == 'admin'
        && request.resource.data.published == true
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
